@page "/perfil/delete"
@* @inject IDbContextFactory<BuscarAPI_V2.Main.Data.BuscarAPI_V2MainContext> DbFactory *@
@inject NavigationManager NavigationManager
@inject IPerfilService perfilService

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Perfil</h2>
    <hr />
    @if (perfil is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">DescricaoPerfil</dt>
            <dd class="col-sm-10">@perfil.DescricaoPerfil</dd>
        </dl>
        <EditForm method="post" Model="perfil" OnValidSubmit="DeletePerfil" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(perfil is null)">Delete</button> |
            <a href="/perfils">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Perfil? perfil;

    [SupplyParameterFromQuery]
    private int Id_Perfil { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // using var context = DbFactory.CreateDbContext();
        // perfil = await context.Perfil.FirstOrDefaultAsync(m => m.Id_Perfil == Id_Perfil);

        // if (perfil is null)
        // {
        //     NavigationManager.NotFound();
        // }

        perfil = await perfilService.GetPerfilId(Id_Perfil);

        if (perfil is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeletePerfil()
    {
        // using var context = DbFactory.CreateDbContext();
        // context.Perfil.Remove(perfil!);
        // await context.SaveChangesAsync();
        // NavigationManager.NavigateTo("/perfils");

        await perfilService.DeletePerfil(Id_Perfil);
        NavigationManager.NavigateTo("/perfis");
    }
}
